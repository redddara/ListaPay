rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOwner() {
      return isSignedIn() && userDoc().data.role == 'owner';
    }

    function isCashier() {
      return isSignedIn() && userDoc().data.role == 'cashier';
    }

    function belongsToStore(storeId) {
      return isSignedIn() && userDoc().data.storeId == storeId;
    }

    function validTimestamp(field) {
      return request.resource.data[field] is timestamp;
    }

    function noFieldChanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // User profiles — only self or store owner may read; only owner manages roles
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        (isOwner() && resource.data.storeId == userDoc().data.storeId)
      );
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner() && resource.data.storeId == userDoc().data.storeId;
      allow delete: if false;
    }

    match /stores/{storeId} {
      allow read: if belongsToStore(storeId);
      allow write: if isOwner() && belongsToStore(storeId);

      match /customers/{customerId} {
        allow read: if belongsToStore(storeId);
        allow create, update: if belongsToStore(storeId) && (
          isOwner() || isCashier()
        );
        allow delete: if isOwner();

        match /transactions/{transactionId} {
          allow read: if belongsToStore(storeId);
          allow create: if belongsToStore(storeId) && (
            isOwner() || isCashier()
          );
          allow update: if isOwner();
          allow delete: if isOwner();
        }
      }

      match /audit_logs/{logId} {
        allow read: if isOwner() && belongsToStore(storeId);
        allow create: if belongsToStore(storeId);
        allow update, delete: if false;
      }

      match /backups/{backupId} {
        allow read, write: if isOwner() && belongsToStore(storeId);
      }

      match /sync_meta/{docId} {
        allow read, write: if belongsToStore(storeId);
      }
    }
  }
}
